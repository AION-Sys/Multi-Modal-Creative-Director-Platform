# Copy to .env and fill in. Loaded by src/creative_director/config.py.

# --- API auth (static API key for the MVP) ---
# Clients must send this value in the `X-API-Key` header.
APP_API_KEY=changeme-dev-key

# --- Director agent (Anthropic) ---
ANTHROPIC_API_KEY=
# Model used by the director/planning and self-critique steps.
DIRECTOR_MODEL=claude-opus-5

# --- Backend selection: "memory" or "airtable" ---
BACKEND=memory

# --- Airtable (only needed when BACKEND=airtable) ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# --- Image generation provider ---
# "openai" for gpt-image-1, or "stub" for a keyless placeholder provider.
IMAGE_PROVIDER=stub
OPENAI_API_KEY=

# --- Text/copy generation provider ---
# "anthropic" for Claude copywriting (uses ANTHROPIC_API_KEY), or "stub".
TEXT_PROVIDER=stub
TEXT_MODEL=claude-opus-5

# --- Object storage: "local" for now (S3/R2 later) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./.data/media
